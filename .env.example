# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Job queue guard (see supabase/migrations/*_pgmq_pg_cron.sql and
# src/lib/queue/*). pg_cron's dispatcher sends this as a Bearer token on
# every /api/jobs/* request — set to the SAME value as the Vault secret
# `job_dispatch_secret` (locally: supabase/local-dispatch-secrets.sql).
CRON_SECRET=

# LLM provider for task extraction/consolidation. "openai" (gpt-5.6-luna) is
# the intended eventual default; "anthropic" (claude-haiku-4-5) stays fully
# supported as an A/B comparison lever. Only the SELECTED provider's key is
# required — see refineLlmKeys in src/lib/env.ts.
LLM_PROVIDER=anthropic
# Required only when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Required UNCONDITIONALLY, regardless of LLM_PROVIDER — embeddings
# (services/search/embed.ts, text-embedding-3-small) always call OpenAI.
OPENAI_API_KEY=

# Google OAuth for SIGN-IN (console.cloud.google.com). Only consumed by
# `supabase config push` to configure the Auth service — never read by the
# Next.js app directly. Leave unset and auth.external.google's `enabled`
# false in supabase/config.toml if you don't want Google login.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Nango (self-hosted) — owns OAuth/token custody for the Slack and Google
# CONNECTORS (distinct from Google sign-in above). See
# NANGO_MIGRATION_LOG.md for the full rationale. Local dev: run
# `docker compose up -d` in .nango-local/, sign up at http://localhost:3003,
# create a "google" integration (enable the Gmail, Drive, Chat and People
# APIs in console.cloud.google.com first) and a "slack" integration.
# Both consoles need `{NANGO_SERVER_URL}/oauth/callback` registered as a
# redirect URI. Copy the environment's Secret Key below — never the same
# key across local and prod, each Nango environment (dev/prod) has its own.
NANGO_SERVER_URL=http://localhost:3003
NANGO_SECRET_KEY=
# Server API and Connect UI are two different ports in the local docker
# compose stack (SERVER_PORT and CONNECT_UI_PORT) — don't collapse these to
# the same value.
NEXT_PUBLIC_NANGO_HOST=http://localhost:3003
NEXT_PUBLIC_NANGO_CONNECT_URL=http://localhost:3009
