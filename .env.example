# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Token encryption (AES-256-GCM). Format: "<version>:<base64 32-byte key>,<version>:<base64 32-byte key>"
# Generate a key with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEYS=1:REPLACE_WITH_BASE64_32_BYTES
TOKEN_ENC_ACTIVE_VERSION=1

# Cron guard (Vercel Cron sends this as a Bearer token)
CRON_SECRET=

# Upstash QStash. QSTASH_URL defaults to the global endpoint if unset — only
# set it if your Upstash account is provisioned in a specific region
# (e.g. https://qstash-eu-central-1.upstash.io).
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Slack OAuth app (console.slack.com/apps)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Signing secret for the connector OAuth `state` param — shared by every
# connector (Slack, Gmail, Google Drive, Google Chat), any long random
# string. SLACK_OAUTH_STATE_SECRET is accepted as a fallback for
# already-deployed environments (Vercel env vars are write-only once set —
# see CLAUDE.md); set OAUTH_STATE_SECRET going forward.
OAUTH_STATE_SECRET=REPLACE_WITH_RANDOM_STRING

# LLM provider
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Google OAuth for SIGN-IN (console.cloud.google.com). Only consumed by
# `supabase config push` to configure the Auth service — never read by the
# Next.js app directly. Leave unset and auth.external.google's `enabled`
# false in supabase/config.toml if you don't want Google login.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Google OAuth for the Gmail/Drive/Chat CONNECTORS — a separate OAuth client
# from the sign-in one above (different redirect-URI allow-list; rotating
# this must not sign users out). Console.cloud.google.com: enable the
# Gmail API, Drive API, Chat API, AND People API (the last one resolves
# Google Chat sender ids to real names/emails — its own API, easy to miss
# since it's not one of the three "connector" APIs); create a Web
# application OAuth client; publish the consent screen Internal to your
# Workspace org; and register these exact redirect URIs for every origin
# you run this app at (e.g. http://localhost:3000 and your production
# domain):
#   {origin}/api/oauth/gmail/callback
#   {origin}/api/oauth/google_drive/callback
#   {origin}/api/oauth/google_chat/callback
GOOGLE_CONNECTOR_CLIENT_ID=
GOOGLE_CONNECTOR_CLIENT_SECRET=