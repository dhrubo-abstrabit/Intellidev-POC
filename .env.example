# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Token encryption (AES-256-GCM). Format: "<version>:<base64 32-byte key>,<version>:<base64 32-byte key>"
# Generate a key with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEYS=1:REPLACE_WITH_BASE64_32_BYTES
TOKEN_ENC_ACTIVE_VERSION=1

# Cron guard (Vercel Cron sends this as a Bearer token)
CRON_SECRET=

# Upstash QStash. QSTASH_URL defaults to the global endpoint if unset — only
# set it if your Upstash account is provisioned in a specific region
# (e.g. https://qstash-eu-central-1.upstash.io).
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Slack OAuth app
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Signing secret for the state param (any long random string)
SLACK_OAUTH_STATE_SECRET=REPLACE_WITH_RANDOM_STRING

# LLM provider
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
