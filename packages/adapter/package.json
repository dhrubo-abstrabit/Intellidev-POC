{
  "name": "@intellidev/adapter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Runs inside the run container. Owns harness drivers, the stage engine, the MCP gateway, the credential broker and the git workflow.",
  "main": "./src/index.ts",
  "bin": {
    "intellidev-adapter": "./src/cli/adapter.ts",
    "intellidev-cred": "./src/cli/cred.ts"
  },
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./runner/*": "./src/runner/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node build.mjs"
  },
  "dependencies": {
    "@intellidev/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ajv": "^8.20.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
